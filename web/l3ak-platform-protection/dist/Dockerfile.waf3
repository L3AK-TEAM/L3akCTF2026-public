FROM gcc:latest AS readflag-builder
WORKDIR /app
COPY readflag.c .

RUN gcc -static -o readflag readflag.c

# ─── stage 1: build the Coraza WAF (level waf3) ──────────────────────────
# coraza + coreruleset track recent Go; 1.25 covers current releases.
FROM golang:1.25 AS waf-builder
WORKDIR /src
COPY waf3/go.mod ./
COPY waf3/main.go ./
# Resolve module versions at build time, then build a static binary so it runs
# on the slim alpine runtime regardless of libc.
RUN go mod tidy && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /coraza-waf .

# ─── stage 2: build the Next.js app (standalone output) ───────────────────
FROM node:22.23.0-alpine AS app-builder
WORKDIR /app
COPY app/package.json app/package-lock.json ./
RUN npm ci
COPY app/ ./
RUN npm run build

# ─── stage 3: runtime — Next standalone server + WAF in one image ─────────
FROM node:22.23.0-alpine
WORKDIR /app
ENV NODE_ENV=production


COPY --from=readflag-builder /app/readflag /readflag
RUN chmod 4511 /readflag

# Next.js standalone server + assets, owned by the built-in non-root `node`
# user (uid 1000) so the server can read them and write its .next/cache.
COPY --from=app-builder --chown=node:node /app/public ./public
COPY --from=app-builder --chown=node:node /app/.next/standalone ./
COPY --from=app-builder --chown=node:node /app/.next/static ./.next/static

# Coraza WAF binary + rules (rules are read from disk at startup, not baked in).
COPY --from=waf-builder /coraza-waf /usr/local/bin/coraza-waf
COPY waf3/rules ./rules
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV WAF_LISTEN=:8080 \
    BACKEND=http://127.0.0.1:3000 \
    WAF_RULES=/app/rules/main.conf \
    HOSTNAME=127.0.0.1 \
    PORT=3000

# Both listeners are >1024, so binding them needs no privileges.
EXPOSE 8080

# Drop privileges: the Next server and the WAF both run as `node`.
USER node
ENTRYPOINT ["/entrypoint.sh"]
