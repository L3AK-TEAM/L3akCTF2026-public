<!DOCTYPE html>
<html>
<head>
  <title>Create Page — SecureApp</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: monospace; background: #0a0a0a; color: #e0e0e0; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
    .container { background: #1a1a1a; padding: 2rem; border-radius: 8px; width: 100%; max-width: 600px; border: 1px solid #333; }
    h1 { color: #00ff88; margin-bottom: 0.5rem; text-align: center; }
    p.desc { color: #888; margin-bottom: 1.5rem; text-align: center; font-size: 0.9rem; }
    label { display: block; margin-bottom: 0.3rem; color: #aaa; }
    textarea { width: 100%; height: 200px; padding: 0.5rem; margin-bottom: 1rem; background: #0a0a0a; border: 1px solid #333; color: #e0e0e0; border-radius: 4px; font-family: monospace; resize: vertical; }
    button { width: 100%; padding: 0.6rem; background: #00ff88; color: #0a0a0a; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-family: monospace; }
    button:hover { background: #00cc6a; }
    .result { margin-top: 1rem; padding: 0.8rem; border-radius: 4px; background: #0a2a0a; border: 1px solid #00ff88; }
    .result a { color: #00ff88; word-break: break-all; }
    .back { display: inline-block; margin-top: 1rem; color: #888; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Create Page</h1>
    <p class="desc">Publish an HTML page on pages.ctf.test</p>
    <form method="POST" action="/pages/upload">
      <label>HTML Content</label>
      <textarea name="html" placeholder="<h1>Hello World</h1>" required></textarea>
      <button type="submit">Publish</button>
    </form>
    <% if (result) { %>
      <div class="result">
        Page published: <a href="<%= result.url %>" target="_blank"><%= result.url %></a>
      </div>
    <% } %>
    <a href="/dashboard" class="back">Back to Dashboard</a>
  </div>
</body>
</html>
