R_U1_BIAS net_tap 0 1300999

.model NCLOWN NMOS LEVEL=1 VTO=0.37 KP=83u LAMBDA=0
.model PCLOWN PMOS LEVEL=1 VTO=-0.41 KP=47u LAMBDA=0

.param U1_A=700000043 U1_RG=9137 U1_RF=9821
E_U1 u1_out 0 net_tap u1_n {U1_A}
R_U1_G u1_n 0 {U1_RG}
R_U1_F u1_out u1_n {U1_RF}

.param CM1_WR=8 CM1_LR=3 CM1_WO=11 CM1_LO=4 CM1_RSET=18713 CM1_RLOAD=5711
G_CM1 cm1_out 0 u1_out 0 {((CM1_WO/CM1_LO)/(CM1_WR/CM1_LR))/CM1_RSET}
R_CM1_LOAD cm1_out 0 {CM1_RLOAD}
R_CM1_SET_DUMMY u1_out cm1_sink {CM1_RSET}
V_CM1_SINK cm1_sink 0 0
M_CM1_REF cm1_ref cm1_ref 0 0 NCLOWN W=8u L=3u
M_CM1_OUT cm1_shadow cm1_ref 0 0 NCLOWN W=11u L=4u

.param U2_A=850000021 U2_RIN=12011 U2_RF=24851
E_U2 u2_out 0 0 u2_n {U2_A}
R_U2_IN cm1_out u2_n {U2_RIN}
R_U2_F u2_out u2_n {U2_RF}

.param CM2_WR=5 CM2_LR=2 CM2_WO=13 CM2_LO=3 CM2_RSET=21089 CM2_RLOAD=4987
G_CM2 0 cm2_out u2_out 0 {((CM2_WO/CM2_LO)/(CM2_WR/CM2_LR))/CM2_RSET}
R_CM2_LOAD cm2_out 0 {CM2_RLOAD}
R_CM2_SET_DUMMY u2_out cm2_sink {CM2_RSET}
V_CM2_SINK cm2_sink 0 0
M_CM2_REF cm2_ref cm2_ref vdd vdd PCLOWN W=5u L=2u
M_CM2_OUT cm2_shadow cm2_ref vdd vdd PCLOWN W=13u L=3u

.param U3_A=930000011 U3_RG=15511 U3_RF=19037
E_U3 u3_out 0 cm2_out u3_n {U3_A}
R_U3_G u3_n 0 {U3_RG}
R_U3_F u3_out u3_n {U3_RF}

.param CM3_WR=9 CM3_LR=5 CM3_WO=7 CM3_LO=4 CM3_RSET=17401 CM3_RLOAD=3907
G_CM3 cm3_out 0 u3_out 0 {((CM3_WO/CM3_LO)/(CM3_WR/CM3_LR))/CM3_RSET}
R_CM3_LOAD cm3_out 0 {CM3_RLOAD}
R_CM3_SET_DUMMY u3_out cm3_sink {CM3_RSET}
V_CM3_SINK cm3_sink 0 0
M_CM3_REF cm3_ref cm3_ref 0 0 NCLOWN W=9u L=5u
M_CM3_OUT cm3_shadow cm3_ref 0 0 NCLOWN W=7u L=4u

.param U4_A=760000033 U4_RIN=22307 U4_RF=40163
E_U4 final_out 0 0 u4_n {U4_A}
R_U4_IN cm3_out u4_n {U4_RIN}
R_U4_F final_out u4_n {U4_RF}

VDD vdd 0 DC 5
.end
